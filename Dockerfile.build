ARG BASE_IMAGE=ubuntu:24.04

FROM ${BASE_IMAGE} AS builder

ARG DISTRO_FAMILY
ARG DISTRO_ID

ENV DEBIAN_FRONTEND=noninteractive

# ---- Install build dependencies (cached per base image) ----
RUN if [ "$DISTRO_FAMILY" = "deb" ]; then \
        apt-get update && apt-get install -y --no-install-recommends \
            build-essential pkg-config curl ca-certificates \
            libgtk-4-dev libadwaita-1-dev \
            libpulse-dev libpipewire-0.3-dev libusb-1.0-0-dev \
            libasound2-dev libclang-dev clang dpkg-dev \
            libssl-dev \
        && rm -rf /var/lib/apt/lists/*; \
    elif [ "$DISTRO_FAMILY" = "rpm" ]; then \
        dnf install -y --setopt=install_weak_deps=False \
            gcc gcc-c++ make pkg-config curl ca-certificates \
            gtk4-devel libadwaita-devel \
            pulseaudio-libs-devel pipewire-devel libusb1-devel \
            alsa-lib-devel clang-devel clang rpm-build \
            openssl-devel \
        && dnf clean all; \
    elif [ "$DISTRO_FAMILY" = "suse" ]; then \
        zypper --non-interactive refresh && \
        zypper --non-interactive install --no-recommends \
            gcc gcc-c++ make pkg-config curl ca-certificates \
            gtk4-devel libadwaita-devel \
            libpulse-devel pipewire-devel libusb-1_0-devel \
            alsa-devel clang-devel clang rpm-build \
            libopenssl-devel \
        && zypper clean --all; \
    elif [ "$DISTRO_FAMILY" = "arch" ]; then \
        pacman -Syu --noconfirm \
            base-devel pkg-config curl ca-certificates \
            gtk4 libadwaita \
            libpulse pipewire libusb \
            alsa-lib clang \
            zstd openssl \
        && pacman -Scc --noconfirm; \
    fi

# ---- Install Rust (cached per base image) ----
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

# ---- Copy source + build ---------------------------------------------
# Single workspace build now that the Python launcher + the per-crate
# cdylib install steps are gone. The cargo cache mount lives at the
# workspace target dir.
COPY . /build

RUN --mount=type=cache,target=/build/src_rust/target,id=rust-workspace-${DISTRO_ID} \
    cargo build --manifest-path src_rust/Cargo.toml --release --bin hiresti && \
    mkdir -p /build/rust_out && \
    cp src_rust/target/release/hiresti /build/rust_out/

# Package — package.sh installs the pre-built binary from rust_out/.
CMD ["bash", "-c", "./package.sh ${PKG_TYPE} ${VERSION} && cp dist/* /output/"]
